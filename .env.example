EMAIL_HOST=smtp.your_server.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_mail@your_domain.com
EMAIL_HOST_PASSWORD=Your_Strong_Mail_Password
DEFAULT_FROM_EMAIL=your_mail@your_domain.com
MAIN_TITLE=MiniSocial
SECRET_KEY=django-insecure-YOUR_KEY
DJANGO_DEBUG=True
ANYDB_UID=YourUser
ANYDB_PWD=YourStrongPassword
ANYDB_SERVERNAME=YourServerName
ANYDB_DBN=YourDatabaseName
ANYDB_HOST=YourServerHostOrIP:2638
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 your.domain.com
# Может иметь 3 значения: prod, dev, test (default: dev)
ENVIRONMENT=dev
# Три отдельные строки подключения (DSN)
DATABASE_URL_DEV=postgres://django:dev_pass@127.0.0.1:5432/myproj_dev
DATABASE_URL_TEST=postgres://django:test_pass@127.0.0.1:5432/myproj_test
DATABASE_URL_PROD=postgres://django:prod_pass@postgres_ip:5432/myproj_prod
DATABASE_URL=postgres://django:django_password@postgres_IP:5432/YourDB
